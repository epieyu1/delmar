# Copia este archivo como `.env.local` y rellena las dos claves.
# Están en Supabase → Project Settings → API.
# La clave `anon` es pública por diseño: quien protege los datos son las políticas RLS
# de supabase/schema.sql, no el secreto de la clave.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON
